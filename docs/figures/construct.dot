// High-level site-profile construction. Reviewed 2026-07-23.
digraph construct {
  rankdir=LR;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        fillcolor="white", color="#3D4A56", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=9, color="#3D4A56", penwidth=1.1];

  measure [label="Login measurements\nsite + scheduler facts", color="#0E7C86"];
  docs [label="Discovery agent\nsearch + download tools", color="#534AB7"];
  pilots [label="Approved pilot jobs\nplanned", color="#B0710E", style="rounded,dashed"];
  construct [label="Deterministic validation\n+ reconciliation", color="#0E7C86"];
  output [label="Site profile\n+ evidence report", color="#0E7C86"];

  measure -> docs [label="site signals"];
  measure -> construct;
  docs -> construct;
  pilots -> construct [style=dashed];
  construct -> output;
}
