        "command_id": "storage_writable",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/storage/locations/*/executable",
        "type": "boolean",
        "description": "Whether the reviewed directory can be traversed.",
        "method": "python_api",
        "command_id": "storage_executable",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/storage/locations/*/permissions",
        "type": "string",
        "description": "Unix permission string for the reviewed path.",
