{
  "schema_version": "0.2",
  "catalog_id": "common-login-measurements",
  "statuses": {
    "observed": "The value was collected.",
    "unavailable": "The value could not be collected.",
    "hidden": "The site did not expose the value to the current user.",
    "command_unavailable": "The reviewed command was not installed.",
    "permission_denied": "The current user could not observe the value.",
    "not_applicable": "The fact does not apply to the selected scheduler or site.",
    "failed": "The bounded observation failed."
  },
  "categories": {
    "collection": [
      {
        "path": "/schema_version",
        "type": "string",
        "description": "Login-measurement contract version.",
        "method": "derived",
        "command_id": "measurement_schema_version",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/collected_at",
        "type": "string",
        "description": "UTC time when collection completed.",
        "method": "python_api",
        "command_id": "collection_timestamp",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/evidence_source",
        "type": "string",
        "description": "Whether values were measured or simulated.",
        "method": "derived",
        "command_id": "evidence_source",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/collector_version",
        "type": "string",
        "description": "Version of the login collector.",
        "method": "derived",
        "command_id": "collector_version",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/detected_schedulers",
        "type": "array",
        "description": "Supported schedulers detected from reviewed executables.",
        "method": "executable_lookup",
        "command_id": "detect_schedulers",
        "command": null,
        "requires_write": false,
        "optional": false
      }
    ],
    "identity": [
      {
        "path": "/site_facts/site_id",
        "type": "string",
        "description": "Identifier derived from the short site name.",
        "method": "derived",
        "command_id": "site_id",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/site_facts/site_name",
        "type": "string",
        "description": "Short site name supplied by the user.",
        "method": "derived",
        "command_id": "site_name",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/site_facts/aliases",
        "type": "array",
        "description": "Additional reviewed names for the site.",
        "method": "derived",
        "command_id": "site_aliases",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/hostname",
        "type": "string",
        "description": "Short hostname of the login node.",
        "method": "python_api",
        "command_id": "hostname",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/fqdn",
        "type": "string",
        "description": "Fully qualified login-node hostname.",
        "method": "fixed_command",
        "command_id": "hostname_fqdn",
        "command": ["hostname", "-f"],
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/dns_suffix",
        "type": "string",
        "description": "DNS suffix derived from the login-node FQDN.",
        "method": "derived",
        "command_id": "dns_suffix",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/hostname_patterns",
        "type": "array",
        "description": "Hostname patterns derived from the login-node FQDN.",
        "method": "derived",
        "command_id": "hostname_patterns",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/documentation_domains",
        "type": "array",
        "description": "Official-domain candidates used to bound discovery.",
        "method": "derived",
        "command_id": "documentation_domains",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/preferred_path_tokens",
        "type": "array",
        "description": "Site terms used to rank documentation paths.",
        "method": "derived",
        "command_id": "preferred_path_tokens",
        "command": null,
        "requires_write": false,
        "optional": true
      }
    ],
    "platform": [
      {
        "path": "/site_facts/os_id",
        "type": "string",
        "description": "Operating-system identifier.",
        "method": "fixed_command",
        "command_id": "read_os_release",
        "command": ["cat", "/etc/os-release"],
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/os_version",
        "type": "string",
        "description": "Operating-system version.",
        "method": "derived",
        "command_id": "read_os_release",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/kernel_release",
        "type": "string",
        "description": "Login-node kernel release.",
        "method": "fixed_command",
        "command_id": "kernel_release",
        "command": ["uname", "-r"],
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/architecture",
        "type": "string",
        "description": "Login-node machine architecture.",
        "method": "fixed_command",
        "command_id": "architecture",
        "command": ["uname", "-m"],
        "requires_write": false,
        "optional": true
      }
    ],
    "user": [
      {
        "path": "/site_facts/username",
        "type": "string",
        "description": "Current login username.",
        "method": "python_api",
        "command_id": "username",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/uid",
        "type": "integer",
        "description": "Current numeric user identifier.",
        "method": "python_api",
        "command_id": "uid",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/groups",
        "type": "array",
        "description": "Unix groups visible to the current process.",
        "method": "python_api",
        "command_id": "groups",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/home_directory",
        "type": "string",
        "description": "Current user's home directory.",
        "method": "environment_variable",
        "command_id": "home_directory",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/site_facts/working_directory",
        "type": "string",
        "description": "Working directory used for collection.",
        "method": "python_api",
        "command_id": "working_directory",
        "command": null,
        "requires_write": false,
        "optional": true
      }
    ],
