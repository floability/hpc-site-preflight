        "command_id": "storage_id",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/storage/locations/*/role",
        "type": "string",
        "description": "Broad role inferred from a reviewed path source.",
        "method": "derived",
        "command_id": "storage_role",
        "command": null,
        "requires_write": false,
        "optional": false
      },
      {
        "path": "/storage/locations/*/environment_variables",
        "type": "array",
        "description": "Reviewed environment variables that resolve to the location.",
