        "requires_write": false,
        "optional": true
      },
      {
        "path": "/htcondor/available_commands",
        "type": "array",
        "description": "Reviewed HTCondor commands visible on PATH.",
        "method": "executable_lookup",
        "command_id": "find_htcondor_commands",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/htcondor/submit_command_available",
