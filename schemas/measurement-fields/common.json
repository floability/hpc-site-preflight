        "description": "Whether condor_submit is visible on PATH.",
        "method": "executable_lookup",
        "command_id": "find_condor_submit",
        "command": null,
        "requires_write": false,
        "optional": true
      }
    ],
    "storage": [
      {
        "path": "/storage/locations",
        "type": "array",
        "description": "Reviewed storage locations visible from the login node.",
