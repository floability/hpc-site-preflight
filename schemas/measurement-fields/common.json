        "method": "collector_function",
        "command_id": "test_allowlisted_https",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/networking/local_tcp_bind",
        "type": "boolean",
        "description": "Whether a local TCP listener can bind.",
        "method": "collector_function",
        "command_id": "test_local_tcp_bind",
        "command": null,
        "requires_write": false,
        "optional": true
      },
      {
        "path": "/networking/local_tcp_loopback",
        "type": "boolean",
        "description": "Whether a bounded TCP loopback exchange succeeds.",
        "method": "collector_function",
        "command_id": "test_local_tcp_loopback",
        "command": null,
        "requires_write": false,
        "optional": true
      }
