{
  "schema_version": "0.1",
  "catalog_id": "slurm-login-measurements",
  "title": "Safely observable Slurm login-node facts",
  "scheduler": "slurm",
  "status_catalog": "common.json#/statuses",
  "fields": [
    {
      "path": "/facts/scheduler/cluster_name",
      "type": "string",
      "description": "Slurm cluster name visible to the current user.",
      "method": "fixed_command",
      "command_id": "slurm_config",
      "command": ["scontrol", "show", "config"],
      "output_concept": "ClusterName",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/version",
      "type": "string",
      "description": "Installed Slurm client version.",
      "method": "fixed_command",
      "command_id": "slurm_version",
      "command": ["sinfo", "--version"],
      "output_concept": "Slurm version",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/default_partition",
      "type": "string",
      "description": "Partition marked as the visible default.",
      "method": "derived",
      "command_id": "slurm_partitions",
      "command": null,
      "output_concept": "Partition name containing an asterisk",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/partitions",
      "type": "array",
      "description": "Partitions visible to the current user.",
      "method": "fixed_command",
      "command_id": "slurm_partitions",
      "command": ["sinfo", "--noheader", "--format=%P|%a|%l|%D|%t"],
      "output_concept": "Partition, availability, walltime, node count, and state",
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/facts/scheduler/partitions/*/name",
      "type": "string",
      "description": "Visible partition name without the default marker.",
      "method": "derived",
      "command_id": "slurm_partitions",
      "command": null,
      "output_concept": "Partition field",
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/facts/scheduler/partitions/*/available",
      "type": "boolean",
      "description": "Whether Slurm reports the partition as available.",
      "method": "derived",
      "command_id": "slurm_partitions",
      "command": null,
      "output_concept": "Availability field",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/partitions/*/maximum_walltime_seconds",
      "type": "integer",
      "description": "Walltime reported by Slurm in seconds, with -1 meaning unlimited.",
      "method": "fixed_command",
      "command_id": "slurm_partition_walltimes",
      "command": ["sinfo", "-h", "-o", "%P %l"],
      "output_concept": "Partition and normalized time limit",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/partitions/*/node_count",
      "type": "integer",
      "description": "Number of visible nodes reported for the partition.",
      "method": "derived",
      "command_id": "slurm_partitions",
      "command": null,
      "output_concept": "Node count field summed across partition states",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/partitions/*/node_states",
      "type": "array",
      "description": "Visible node states reported within the partition.",
      "method": "derived",
      "command_id": "slurm_partitions",
      "command": null,
      "output_concept": "State fields grouped by partition",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_states",
      "type": "array",
      "description": "Counts of visible nodes grouped by Slurm state.",
      "method": "fixed_command",
      "command_id": "slurm_node_states",
      "command": ["sinfo", "--nodes", "--noheader", "--format=%T"],
      "output_concept": "Long-form node state",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_states/*/state",
      "type": "string",
      "description": "Visible Slurm node state name.",
      "method": "derived",
      "command_id": "slurm_node_states",
      "command": null,
      "output_concept": "Normalized state value",
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/facts/scheduler/node_states/*/count",
      "type": "integer",
      "description": "Number of visible nodes in the state.",
      "method": "derived",
      "command_id": "slurm_node_states",
      "command": null,
      "output_concept": "Count of equal normalized state values",
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/facts/scheduler/node_shapes",
      "type": "array",
      "description": "Distinct visible Slurm node resource shapes.",
      "method": "fixed_command",
      "command_id": "slurm_node_shapes",
      "command": ["sinfo", "--nodes", "--noheader", "--format=%c|%m|%G|%f|%d"],
      "output_concept": "CPUs, memory, GRES, features, and temporary disk",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/cpus",
      "type": "integer",
      "description": "Logical CPU count in the visible node shape.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "CPU count field",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/memory_mib",
      "type": "integer",
      "description": "Memory in MiB reported for the visible node shape.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "Memory field",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/temporary_disk_mib",
      "type": "integer",
      "description": "Temporary disk in MiB reported for the visible node shape.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "Temporary disk field",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/features",
      "type": "array",
      "description": "Node features reported for the visible node shape.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "Active features field",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/gres",
      "type": "array",
      "description": "Generic resources reported for the visible node shape.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "GRES field",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/gpu_count",
      "type": "integer",
      "description": "GPU count derived from visible GRES entries.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "GPU quantities in GRES entries",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/node_shapes/*/gpu_models",
      "type": "array",
      "description": "GPU model names derived from visible GRES entries.",
      "method": "derived",
      "command_id": "slurm_node_shapes",
      "command": null,
      "output_concept": "GPU type names in GRES entries",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/visible_accounts",
      "type": "array",
      "description": "Slurm account names visible for the current user.",
      "method": "derived",
      "command_id": "slurm_associations",
      "command": null,
      "output_concept": "Distinct Account fields",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/visible_qos",
      "type": "array",
      "description": "Slurm QoS names visible for the current user.",
      "method": "derived",
      "command_id": "slurm_associations",
      "command": null,
      "output_concept": "Distinct QOS fields",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/visible_association_limits",
      "type": "array",
      "description": "Visible user associations and their scheduler-reported limits.",
      "method": "fixed_command",
      "command_id": "slurm_associations",
      "command": ["sacctmgr", "--noheader", "--parsable2", "show", "associations", "Users={username}", "format=Account,Partition,QOS,MaxJobs,MaxSubmit,MaxWall,GrpTRES"],
      "output_concept": "Account, partition, QoS, and association limit fields",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/reservations",
      "type": "array",
      "description": "Reservations visible to the current user.",
      "method": "fixed_command",
      "command_id": "slurm_reservations",
      "command": ["scontrol", "--oneliner", "show", "reservations"],
      "output_concept": "Reservation records",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/visible_configuration",
      "type": "object",
      "description": "Allowlisted visible Slurm configuration as observation, not policy.",
      "method": "fixed_command",
      "command_id": "slurm_config",
      "command": ["scontrol", "show", "config"],
      "output_concept": "ClusterName, SelectType, SelectTypeParameters, TaskPlugin, and MaxArraySize",
      "requires_write": false,
      "optional": true
    }
  ]
}
