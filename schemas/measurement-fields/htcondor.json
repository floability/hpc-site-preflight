      "command_id": "htcondor_collector_host",
      "command": ["condor_config_val", "COLLECTOR_HOST"],
      "output_concept": "COLLECTOR_HOST",
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/facts/scheduler/version",
