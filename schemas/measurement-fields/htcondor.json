{
  "schema_version": "0.2",
  "catalog_id": "htcondor-login-measurements",
  "title": "Safely observable HTCondor login-node facts",
  "scheduler": "htcondor",
  "status_catalog": "common.json#/statuses",
  "fields": [
    {
      "path": "/htcondor/version",
      "type": "string",
      "description": "Installed HTCondor client version.",
      "method": "fixed_command",
      "command_id": "htcondor_version",
      "command": ["condor_version"],
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/collector_host",
      "type": "string",
      "description": "Collector host configured for the local HTCondor client.",
      "method": "fixed_command",
      "command_id": "htcondor_collector_host",
      "command": ["condor_config_val", "COLLECTOR_HOST"],
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/submit_command_available",
      "type": "boolean",
      "description": "Whether condor_submit is visible on PATH.",
      "method": "executable_lookup",
      "command_id": "find_condor_submit",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/file_transfer_supported",
      "type": "boolean",
      "description": "Whether all visible machines advertise file-transfer support.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/pool_totals/machine_count",
      "type": "integer",
      "description": "Number of distinct visible execute machines.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/pool_totals/cpu_cores",
      "type": "integer",
      "description": "Total CPU cores advertised by visible machines.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/pool_totals/memory_mib",
      "type": "integer",
      "description": "Total memory advertised by visible machines.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/pool_totals/advertised_gpus",
      "type": "integer",
      "description": "Total GPUs advertised by visible machines.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/cpu_groups",
      "type": "array",
      "description": "Visible machines grouped only by advertised CPU cores.",
      "method": "fixed_command",
      "command_id": "htcondor_machine_ads",
      "command": [
        "condor_status",
        "-constraint",
        "SlotType =!= \"Dynamic\"",
        "-json",
        "-attributes",
        "Name,Machine,SlotType,PartitionableSlot,Cpus,Memory,TotalCpus,TotalMemory,TotalSlotCpus,TotalSlotMemory,GPUs,TotalGPUs,TotalSlotGPUs,DetectedGPUs,HasFileTransfer"
      ],
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/cpu_groups/*/cpu_cores_per_machine",
      "type": "integer",
      "description": "Advertised CPU cores shared by machines in the group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/cpu_groups/*/machine_count",
      "type": "integer",
      "description": "Visible machine count in the CPU group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/cpu_groups/*/memory_mib_min",
      "type": "integer",
      "description": "Minimum advertised machine memory in the CPU group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/cpu_groups/*/memory_mib_max",
      "type": "integer",
      "description": "Maximum advertised machine memory in the CPU group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/gpu_groups",
      "type": "array",
      "description": "GPU machines grouped by advertised GPU count and CPU cores.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/gpu_groups/*/gpu_count_per_machine",
      "type": "integer",
      "description": "Advertised GPUs shared by machines in the group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/gpu_groups/*/cpu_cores_per_machine",
      "type": "integer",
      "description": "Advertised CPU cores shared by GPU machines in the group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/gpu_groups/*/machine_count",
      "type": "integer",
      "description": "Visible machine count in the GPU group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": false
    },
    {
      "path": "/htcondor/gpu_groups/*/memory_mib_min",
      "type": "integer",
      "description": "Minimum advertised machine memory in the GPU group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": true
    },
    {
      "path": "/htcondor/gpu_groups/*/memory_mib_max",
      "type": "integer",
      "description": "Maximum advertised machine memory in the GPU group.",
      "method": "derived",
      "command_id": "htcondor_machine_ads",
      "command": null,
      "requires_write": false,
      "optional": true
    }
  ]
}
