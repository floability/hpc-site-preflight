{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpc-site-preflight.dev/schemas/site-descriptor.schema.json",
  "title": "HPC Site Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "site_name",
    "scheduler",
    "aliases",
    "hostname_patterns",
    "documentation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "site_name": {
      "type": "string",
      "minLength": 1
    },
    "scheduler": {
      "enum": ["slurm", "htcondor", "unknown"]
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hostname_patterns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_domains", "preferred_path_tokens"],
      "properties": {
        "allowed_domains": {
          "type": "array",
          "items": {"type": "string"}
        },
        "preferred_path_tokens": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
